{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker: no script, Cloudflare serves the built site from dist/.
  // Views are real paths (/posters, /calendar); unknown paths get index.html and the app routes them.
  "name": "conference-planner",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
